{
  "llm": {
    "provider": "cerebras",
    "model_env": "LLM_MODEL",
    "model_default": "gpt-oss-120b",
    "max_requests_per_min": 5,
    "daily_token_cap": 950000
  },
  "pipeline": {
    "system": "b1",
    "max_retries": 2,
    "max_tokens_per_call": 8000,
    "token_cap_per_test": 60000,
    "temperature": 0.7,
    "seed": 1,
    "require_smells_removed": true
  },
  "paths": {
    "projects": "data/projects",
    "utrefactor": "data/utrefactor",
    "tsdetect_jar": "data/utrefactor/detection/v3/TestSmellDetector.jar",
    "mvn": "mvn"
  }
}
